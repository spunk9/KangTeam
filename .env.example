# ─────────────────────────────────────────────────────────────
#  KANG TEAM · Configuración
#  Copia este archivo como ".env" y rellena lo que necesites.
# ─────────────────────────────────────────────────────────────

# Puerto del servidor
PORT=3000

# Datos de la tienda (se muestran en la web y en los pedidos)
STORE_NAME=KANG Team
STORE_WHATSAPP=34600000000
STORE_EMAIL=pedidos@tudominio.com
STORE_INSTAGRAM=kangteam

# Token para lanzar una sincronización manual del catálogo:
#   curl -X POST http://localhost:3000/api/sync -H "x-admin-token: TU_TOKEN"
ADMIN_TOKEN=cambia-este-token

# Cada cuántas horas se refresca el catálogo desde Yupoo
SYNC_INTERVAL_HOURS=6

# ── EMAIL (opcional, elige un proveedor) ─────────────────────
# Opción A · Resend (https://resend.com) — recomendado
RESEND_API_KEY=
ORDER_FROM=KANG Team <pedidos@tudominio.com>
ORDER_TO=

# Opción B · Brevo (https://brevo.com)
BREVO_API_KEY=

# Opción C · Gmail SMTP (requiere verificación en dos pasos y contraseña de aplicación)
# Crea una en https://myaccount.google.com/apppasswords. No uses tu contraseña habitual.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Opción D · Webhook genérico (Zapier, Make, n8n, Discord...)
ORDER_WEBHOOK_URL=

# ── WHATSAPP automático (opcional) ───────────────────────────
# CallMeBot: https://www.callmebot.com/blog/free-api-whatsapp-messages/
CALLMEBOT_PHONE=
CALLMEBOT_APIKEY=

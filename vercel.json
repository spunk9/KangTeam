{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "functions": {
    "api/*.js": {
      "includeFiles": "data/catalog.json"
    },
    "api/img/*.js": {
      "includeFiles": "data/catalog.json"
    }
  },
  "rewrites": [
    {
      "source": "/img/:path*",
      "destination": "/api/img/:path*"
    }
  ]
}

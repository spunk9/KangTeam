{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "public",
  "functions": {
    "api/*.js": {
      "includeFiles": "data/catalog.json"
    },
    "api/album/*.js": {
      "maxDuration": 60,
      "includeFiles": "data/catalog.json"
    }
  },
  "rewrites": [
    {
      "source": "/img/:source/:folder/:hash/:filename",
      "destination": "/api/img?source=:source&folder=:folder&hash=:hash&filename=:filename"
    },
    {
      "source": "/img/:folder/:hash/:filename",
      "destination": "/api/img?folder=:folder&hash=:hash&filename=:filename"
    }
  ]
}
